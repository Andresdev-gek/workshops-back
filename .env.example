PORT=3000
NODE_ENV=development

# PostgreSQL (Neon) — identidades
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require"

# MongoDB Atlas — talleres y reservas
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>/<db>?appName=Cluster0"

# Autenticación
JWT_SECRET="<valor aleatorio largo, generado con: openssl rand -hex 32>"
JWT_EXPIRES_IN="1h"

# CORS
FRONTEND_URL="http://localhost:5173"
